# Supabase project API settings. The publishable key is safe for browser/API use,
# but Row Level Security must be enabled for every exposed table.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase dashboard: Project Settings > Database > Connection string.
# Use the session pooler connection string for hosted deployments.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

ALLOWED_HOSTS=localhost,127.0.0.1